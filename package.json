{
  "name": "coffee-make",
  "private": true,
  "version": "3.0.0",
  "description": "Segundo cerebro personal: módulos de Hogar y Café en una PWA sin servidor.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8123 --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8124 --host 127.0.0.1",
    "test": "vitest run",
    "repartir": "vite-node tools/repartir.ts",
    "check": "tsc --noEmit",
    "desplegar": "node tools/desplegar.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "dexie": "^4.4.6",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
